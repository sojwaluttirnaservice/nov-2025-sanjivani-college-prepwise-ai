# ========= ENVIRONMENT =========
# DEV | PROD
PROJECT_ENV=DEV

# ========= SERVER =========
PORT=4020

# ========= DATABASE =========
MONGODB_URI=mongodb://localhost:27017/prepwise_dev

# ========= SECURITY =========
# Use long random strings — never commit real values
JWT_SECRET_KEY=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# Production overrides (optional, used when PROJECT_ENV=PROD)
# JWT_SECRET_KEY_PROD=your_prod_jwt_secret_here
# SESSION_SECRET_PROD=your_prod_session_secret_here

# ========= CORS =========
ALLOWED_ORIGIN=http://localhost:5173

# Production origin (optional)
# ALLOWED_ORIGIN_PROD=https://your-production-domain.com

# ========= LLM CONFIGURATION =========
# Choose your AI provider: CHATGPT | GEMINI
LLM_PROVIDER=GEMINI

# --- Gemini (Google) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- ChatGPT (OpenAI) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ========= SEED ADMIN CREDENTIALS =========
# Used only when running: node seeds/seedAdmin.js
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Super Admin
